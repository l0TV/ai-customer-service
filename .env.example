# ==========================================================
# 拾汇商城 AI 智能客服服务 —— 环境变量模板
# 复制为 .env 后填写真实值：copy .env.example .env
# ==========================================================

# ---------- 大模型（DeepSeek，OpenAI 兼容协议）----------
# 必填：DeepSeek 控制台 https://platform.deepseek.com 申请
AI_CS_DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AI_CS_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
AI_CS_CHAT_MODEL=deepseek-chat
# 政策问答要求稳定可复现，建议保持 0
AI_CS_TEMPERATURE=0.0

# ---------- 向量模型（本地离线，无需 Key）----------
# 首次启动会从 HuggingFace 下载约 95MB；国内网络慢时可先执行
#   scripts\download_model.py --mirror
AI_CS_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
AI_CS_EMBEDDING_DIM=512
AI_CS_EMBEDDING_DEVICE=cpu

# ---------- Milvus（WSL Docker 中已部署）----------
AI_CS_MILVUS_URI=http://127.0.0.1:19530
AI_CS_MILVUS_COLLECTION=tenhub_policy_chunks

# ---------- 混合检索参数 ----------
AI_CS_CHUNK_SIZE=500
AI_CS_CHUNK_OVERLAP=80
AI_CS_DENSE_TOP_K=8
AI_CS_SPARSE_TOP_K=8
AI_CS_FUSION_TOP_K=6
AI_CS_RRF_C=60
AI_CS_RRF_WEIGHT_DENSE=0.5
AI_CS_RRF_WEIGHT_SPARSE=0.5
# 相关性门控阈值：低于该 COSINE 相似度的片段不作为作答依据（触发拒答）
# 实测：相关政策问题 0.55~0.75，无关问题约 0.33，故取 0.40 留出间隔
AI_CS_RELEVANCE_THRESHOLD=0.40

# ---------- Java 后端集成（经 Spring Cloud Gateway）----------
AI_CS_GATEWAY_BASE_URL=http://127.0.0.1:88
AI_CS_COMPLAINT_CREATE_PATH=/api/member/complaint/create
AI_CS_COMPLAINT_LIST_PATH=/api/member/complaint/list
AI_CS_GATEWAY_TIMEOUT=15.0

# ---------- 服务自身 ----------
AI_CS_HOST=0.0.0.0
# 8080 可能被其它 Java 进程占用，默认使用 8090
AI_CS_PORT=8090
AI_CS_LOG_LEVEL=INFO

# ---------- Nacos 服务注册（供 Spring Cloud Gateway 发现）----------
AI_CS_NACOS_ENABLED=true
AI_CS_NACOS_SERVER_ADDR=127.0.0.1:8848
# 留空 = public 命名空间。
# 注意：本项目网关的服务发现实际用的是 public（gateway 配置里的 namespace
# 只作用于配置中心），tenhub-member 也注册在 public，所以这里保持留空。
AI_CS_NACOS_NAMESPACE=
AI_CS_NACOS_GROUP=DEFAULT_GROUP
AI_CS_NACOS_SERVICE_NAME=tenhub-ai-service
# 【重要】必须显式填写本机局域网 IP！
# 本机有多张网卡（WSL/Hyper-V 虚拟网卡），自动探测可能选中 172.17.x.x 导致网关回调不通。
# 应与其它 Java 服务注册的 IP 一致（本项目实测为 172.29.94.120）。
# 查看方式：Get-NetIPAddress -AddressFamily IPv4
AI_CS_NACOS_IP=172.29.94.120
# 留空则使用 AI_CS_PORT
AI_CS_NACOS_PORT=
# Nacos 开启鉴权时才需要
AI_CS_NACOS_USERNAME=
AI_CS_NACOS_PASSWORD=
